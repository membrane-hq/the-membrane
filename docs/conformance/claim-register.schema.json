{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/membrane-hq/the-membrane/blob/main/docs/conformance/claim-register.schema.json",
  "title": "Membrane Proof-of-Control claim register",
  "type": "object",
  "required": ["register_version", "system_identification", "standard", "conformance_stage", "claim_date", "system_surface_framework", "claims", "trust_assumptions"],
  "properties": {
    "register_version": {"type": "string"},
    "system_identification": {
      "type": "object",
      "required": ["name", "repository", "version", "assessed_ref", "environment"],
      "properties": {
        "name": {"type": "string"},
        "repository": {"type": "string", "format": "uri"},
        "version": {"type": "string"},
        "assessed_ref": {"type": "string"},
        "environment": {"type": "string"}
      }
    },
    "standard": {
      "type": "object",
      "required": ["name", "version", "source"],
      "properties": {
        "name": {"const": "Proof-of-Control"},
        "version": {"type": "string"},
        "source": {"type": "string"}
      }
    },
    "conformance_stage": {"enum": ["Self-Declared", "Third-Party Assessed", "Continuously Monitored"]},
    "claim_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "system_surface_framework": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}}
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "requirement", "domain", "status", "tier", "maestro_layers", "mechanism", "verifiable_fact", "evidence_streams", "trust_assumptions"],
        "properties": {
          "id": {"type": "string", "pattern": "^MBR-"},
          "requirement": {"type": "string", "pattern": "^v0\\.1-C"},
          "domain": {"type": "string"},
          "status": {"enum": ["met-self-declared", "partly", "withdrawn"]},
          "tier": {"type": "integer", "minimum": 1, "maximum": 4},
          "maestro_layers": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 1, "maximum": 7},
            "description": "Required on every claim (v0.1-C9.1.1). An entry with a missing, empty or out-of-range layer field is invalid and must be rejected by validation (v0.1-C9.1.3)."
          },
          "mechanism": {"type": "string"},
          "verifiable_fact": {"type": "string"},
          "evidence_streams": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "trust_assumptions": {"type": "array", "items": {"type": "string", "pattern": "^TA-"}},
          "notes": {"type": "string"}
        }
      }
    },
    "disclosed_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "reason"],
        "properties": {"requirement": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "trust_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "subject", "category", "assumption"],
        "properties": {
          "id": {"type": "string", "pattern": "^TA-"},
          "subject": {"type": "string"},
          "category": {"enum": ["Hardware", "Mathematical", "Ceremony", "Vendor", "Implementation", "Distributed"]},
          "assumption": {"type": "string"}
        }
      }
    }
  }
}
