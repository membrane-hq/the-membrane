[Unit]
Description=Membrane daily OTS rollup (export, sign, stamp)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/opt/membrane/rollup/.env
ExecStart=/opt/membrane/rollup/membrane rollup daily --work-dir /var/lib/membrane/rollup
User=root
Group=root

[Install]
WantedBy=multi-user.target
